{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@tkcom/sim-core": ["packages/sim-core/src/index.ts"],
      "@tkcom/battle-sim": ["packages/battle-sim/src/index.ts"],
      "@tkcom/campaign-sim": ["packages/campaign-sim/src/index.ts"],
      "@tkcom/map-schema": ["packages/map-schema/src/index.ts"],
      "@tkcom/content-schema": ["packages/content-schema/src/index.ts"],
      "@tkcom/renderer": ["packages/renderer/src/index.ts"],
      "@tkcom/storage": ["packages/storage/src/index.ts"],
      "@tkcom/ui-kit": ["packages/ui-kit/src/index.ts"],
      "@tkcom/test-fixtures": ["packages/test-fixtures/src/index.ts"],
      "@tkcom/tooling": ["packages/tooling/src/index.ts"]
    }
  }
}
